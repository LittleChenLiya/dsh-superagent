# dependencies (this package has none, but keep the directory out anyway)
node_modules/

# packed artifacts
*.tgz

# local secrets — never commit a key or an env file
.env
.env.*
*.key
*.pem

# local run state; it normally lives under $DSH_HOME, never in the repo
state/
**/state/superagent/
*.cancel
*.corrupt-*

# logs and editor/OS noise
*.log
# ...except the E2E transcripts: DONE.md cites them as evidence, so they must
# exist in the repository a stranger clones.
!docs/e2e/transcripts/*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# runtime-control demo output (screenshots, audit tail, stop file)
.runtime-demo/
