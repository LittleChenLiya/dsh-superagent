{
  "name": "@xiangyixie/dsh-superagent",
  "version": "0.14.2",
  "description": "长周期自主执行插件：一个目标拆成可并行的子任务，交付一份合并报告，重启后仍可继续。",
  "author": "Admire (LittleChenLiya)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleChenLiya/dsh-superagent.git"
  },
  "homepage": "https://github.com/LittleChenLiya/dsh-superagent#readme",
  "bugs": {
    "url": "https://github.com/LittleChenLiya/dsh-superagent/issues"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "bin": {
    "dsh-superagent-watch": "bin/watch.js",
    "dsh-superagent-report": "bin/report.js",
    "dsh-superagent-doctor": "bin/doctor.js",
    "dsh-superagent-archive": "bin/archive.js",
    "dsh-superagent-sync": "bin/sync.js",
    "dsh-superagent-workbench": "bin/workbench.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/orchestrator.js",
    "lib/store.js",
    "lib/errors.js",
    "lib/usage.js",
    "lib/cost.js",
    "lib/ledger.js",
    "lib/control.js",
    "lib/memory.js",
    "lib/user-memory.js",
    "lib/guard.js",
    "lib/goal.js",
    "lib/cron.js",
    "lib/schedule.js",
    "lib/notify.js",
    "lib/lock.js",
    "lib/templates.js",
    "lib/policy.js",
    "lib/audit.js",
    "lib/inject.js",
    "lib/sync.js",
    "lib/workbench.js",
    "lib/console.js",
    "lib/wizard.js",
    "lib/watch.js",
    "lib/report.js",
    "lib/workspace.js",
    "lib/doctor.js",
    "lib/browser.js",
    "lib/desktop.js",
    "lib/runtime-control.js",
    "bin/watch.js",
    "bin/report.js",
    "bin/doctor.js",
    "bin/archive.js",
    "bin/sync.js",
    "bin/workbench.js",
    "public/workbench.html",
    "public/console.html",
    "cordis.patch.yml",
    "docs/policy.example.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "README.zh.md"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/orchestrator.test.mjs test/direct-and-queue.test.mjs test/dialog.test.mjs test/workspace.test.mjs test/store.test.mjs test/errors.test.mjs test/plugin.test.mjs test/guard.test.mjs test/goal.test.mjs test/cron.test.mjs test/schedule.test.mjs test/audit.test.mjs test/inject.test.mjs test/sync.test.mjs test/workbench.test.mjs test/usage.test.mjs test/cost.test.mjs test/ledger.test.mjs test/control.test.mjs test/watch.test.mjs test/report.test.mjs test/memory.test.mjs test/user-memory.test.mjs test/notify.test.mjs test/templates.test.mjs test/archive.test.mjs test/doctor.test.mjs test/pack.test.mjs test/runtime-control.test.mjs test/console.test.mjs test/wizard.test.mjs",
    "check-pack": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "autonomous",
    "subagent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
