{
  "name": "@xiangyixie/dsh-superagent",
  "version": "0.10.0",
  "description": "Long-horizon autonomous runs for DeepSeek Harness: one goal, model-planned parallel subtasks, one merged report, durable across restarts.",
  "author": "Admire (LittleChenLiya)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleChenLiya/dsh-superagent.git"
  },
  "homepage": "https://github.com/LittleChenLiya/dsh-superagent#readme",
  "bugs": {
    "url": "https://github.com/LittleChenLiya/dsh-superagent/issues"
  },
  "main": "lib/index.js",
  "bin": {
    "dsh-superagent-watch": "bin/watch.js",
    "dsh-superagent-report": "bin/report.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/orchestrator.js",
    "lib/store.js",
    "lib/errors.js",
    "lib/usage.js",
    "lib/control.js",
    "lib/memory.js",
    "lib/notify.js",
    "lib/lock.js",
    "lib/policy.js",
    "lib/audit.js",
    "lib/watch.js",
    "lib/report.js",
    "bin/watch.js",
    "bin/report.js",
    "cordis.patch.yml",
    "docs/policy.example.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/orchestrator.test.mjs test/store.test.mjs test/errors.test.mjs test/plugin.test.mjs test/usage.test.mjs test/control.test.mjs test/watch.test.mjs test/report.test.mjs test/memory.test.mjs test/notify.test.mjs test/audit.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "autonomous",
    "subagent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
